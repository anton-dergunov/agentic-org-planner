;; Machine-local settings, loaded before everything else. Copy to local.el.
;;
;; Vaults are chosen from the UI (Productivity → Vault, or the chip in the file
;; tree's header line) and remembered in vaults.eld. Setting
;; my-org-base-directory here seeds the very first vault, and is ignored once
;; the registry exists. The other settings below are read on every start.
(setq my-org-base-directory "<please provide the path here>")

